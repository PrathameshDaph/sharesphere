# Environment Variables for ShareSphere
DB_URL=jdbc:mysql://localhost:3306/sharesphere?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
JWT_SECRET=sharesphere-super-secret-key-at-least-32-chars-long
JWT_EXPIRATION=86400000
UPLOAD_DIR=uploads
AI_API_KEY=
AI_ENABLED=false
